+    // @RFC{1812} sec 4.3.2.7 / 5.2.7.1: routers report no-route
+    // forwarding failures, subject to the exceptions in @RFC{1122} sec 3.2.2.
+    if (!m_ipForward)
     {
         return;
     }
+    if (!IsUnicast(ipHeader.GetDestination()) || ipHeader.GetFragmentOffset() != 0)
+    {
+        return;
+    }
+
+    const Ipv4Address source = ipHeader.GetSource();
+    const auto firstOctet = static_cast<uint8_t>(source.Get() >> 24);
+    // Do not send ICMP errors to non-host source addresses (0/8,
+    // loopback, multicast, or reserved), or back to this router itself.
+    if (firstOctet == 0 || firstOctet == 127 || firstOctet >= 224 || !IsUnicast(source))
+    {
+        return;
+    }
+    for (uint32_t i = 0; i < GetNInterfaces(); ++i)
+    {
+        for (uint32_t j = 0; j < GetNAddresses(i); ++j)
+        {
+            if (GetAddress(i, j).GetLocal() == source)
+            {
+                return;
+            }
+        }
+    }
+
+    // An error in response to an ICMP error can re-enter the routing
+    // failure callback indefinitely (see @issueid{1408}).
+    if (ipHeader.GetProtocol() == Icmpv4L4Protocol::GetStaticProtocolNumber())
+    {
+        if (packet->GetSize() == 0)
+        {
+            return;
+        }
+        uint8_t type = 0;
+        packet->CopyData(&type, 1);
+        switch (type)
+        {
+        case Icmpv4Header::ICMPV4_DEST_UNREACH:
+        case 4: // Source Quench
+        case 5: // Redirect
+        case Icmpv4Header::ICMPV4_TIME_EXCEEDED:
+        case 12: // Parameter Problem
+            return;
+        default:
+            break;
+        }
+    }
+
     Ptr<Icmpv4L4Protocol> icmp = GetIcmp();
     if (icmp)
     {
